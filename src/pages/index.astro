---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
import { Image } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import createSlug from "../lib/createSlug";

// Three curated highlights for the homepage. Edit this array to change the
// hero reel; everything else lives on /projects.
const HIGHLIGHT_SLUGS = ["silvergait", "retailmind", "pocket-missy"];
const highlights = await Promise.all(
  HIGHLIGHT_SLUGS.map((slug) => getEntry("projects", slug))
);

const allProjects = await getCollection("projects");
const projectCount = allProjects.length;

const lastPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout sideBarActiveItemID="home">
  <div class="pb-12 mt-5">
    <div class="text-xl py-1">Hey there 👋</div>
    <div class="text-5xl font-bold">I'm Jun Wei</div>
    <div class="text-2xl py-3 font-semibold text-base-content/80">
      MSBA at NUS · Building multimodal AI at GovTech
    </div>
    <div class="py-2 text-lg leading-relaxed">
      I build AI products that actually ship, mostly in healthcare and retail. Recently placed 2nd at the AI Innovation Challenge 2026 with <a href="/projects/silvergait" class="link link-hover font-semibold">SilverGait</a>, a phone-camera frailty assessment for seniors. Came into 2026 not knowing what a VPC was; spent the year as a fervent Claude Code abuser and prolific Gemini caller, figuring out where AWS hides the actual error message, and shipping things anyway.
    </div>
    <div class="mt-8">
      <a class="btn" href="https://www.linkedin.com/in/jun-wei-ng-2b06b6251/" target="_blank">Let's connect</a>
      <a href="https://github.com/awpbash" target="_blank" class="btn btn-outline ml-3">GitHub</a>
      <a href="https://huggingface.co/awpbash" target="_blank" class="btn btn-outline ml-3">Huggingface</a>
    </div>
  </div>

  <div class="mb-2 flex items-baseline justify-between">
    <h2 class="text-3xl font-bold">Highlights</h2>
    <a href="/projects" class="text-sm link link-hover text-base-content/70">
      See all {projectCount} projects →
    </a>
  </div>
  <p class="text-base-content/70 mb-5">Three I'd point a recruiter to first.</p>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-12">
    {
      highlights.map((project) => (
        <a
          href={"/projects/" + createSlug(project.data.title, project.slug)}
          class="block rounded-lg overflow-hidden bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[101%]"
        >
          {project.data.heroImage && (
            <Image
              src={project.data.heroImage}
              width={600}
              height={338}
              format="webp"
              alt={project.data.title}
              class="w-full h-44 object-cover"
            />
          )}
          <div class="p-4">
            {project.data.badge && (
              <span class="badge badge-secondary badge-sm mb-2">
                {project.data.badge}
              </span>
            )}
            <h3 class="text-lg font-bold leading-tight mb-1">
              {project.data.title}
            </h3>
            <p class="text-sm text-base-content/70 line-clamp-3">
              {project.data.description}
            </p>
          </div>
        </a>
      ))
    }
  </div>

  <div>
    <div class="text-3xl w-full font-bold mb-5">Latest from blog</div>
  </div>

  {
    lastPosts.map((post) => (
      <>
        <HorizontalCard
          title={post.data.title}
          img={post.data.heroImage}
          desc={post.data.description}
          url={"/blog/" + createSlug(post.data.title, post.slug)}
          target="_self"
          badge={post.data.badge}
        />
        <div class="divider my-0" />
      </>
    ))
  }
</BaseLayout>
