---
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: string;
  heroImage?: string;
  badge?: string;
  relatedProjectUrl?: string | null;
  relatedProjectTitle?: string | null;
  noindex?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  relatedProjectUrl,
  relatedProjectTitle,
  noindex = false,
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = dayjs(pubDate).format("ll");

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const absoluteImage = heroImage
  ? new URL(heroImage, Astro.site ?? Astro.url).toString()
  : undefined;

const blogPostingLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": new Date(pubDate).toISOString(),
  "dateModified": updatedDate ? new Date(updatedDate).toISOString() : new Date(pubDate).toISOString(),
  ...(absoluteImage && { "image": absoluteImage }),
  "author": {
    "@type": "Person",
    "name": "Jun Wei Ng",
    "url": (Astro.site ?? Astro.url).toString()
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": canonicalURL
  }
};
---

<BaseLayout title={title} description={description} image={heroImage} ogType="article" noindex={noindex}>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[1000px] prose-img:mx-auto">
      {heroImage && (
        <Image width={750} height={422} format="webp" src={heroImage} alt={title} class="w-full mb-6" />
      )}
      <h1 class="title my-2 text-4xl font-bold">{title}</h1>
      {pubDate && <time>{displayDate}</time>}
      <br />
      {badge && <div class="badge badge-secondary my-1">{badge}</div>}
      {updatedDate && (
        <div>
          {" "}Last updated on <time>{updatedDate}</time>{" "}
        </div>
      )}
      {relatedProjectUrl && (
        <div class="mt-3 not-prose">
          <a href={relatedProjectUrl} class="btn btn-sm btn-outline">
            ← See the project: {relatedProjectTitle}
          </a>
        </div>
      )}
      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
