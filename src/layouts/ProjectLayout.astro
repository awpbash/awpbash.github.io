---
import BaseLayout from "./BaseLayout.astro";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
import { Image } from "astro:assets";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: string;
  heroImage?: string;
  badge?: string;
  tools?: string[];
  repo?: string;
  demo?: string;
  relatedPostUrl?: string | null;
  relatedPostTitle?: string | null;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  badge,
  tools,
  repo,
  demo,
  relatedPostUrl,
  relatedPostTitle,
} = Astro.props;

dayjs.extend(localizedFormat);
const displayDate = dayjs(updatedDate || pubDate).format("ll");
---

<BaseLayout title={title} description={description} image={heroImage}>
  <main class="md:flex md:justify-center">
    <article class="prose prose-lg max-w-[1000px] prose-img:mx-auto">

      {heroImage && (
        <Image
          width={750}
          height={422}
          format="webp"
          src={heroImage}
          alt={title}
          class="w-full mb-6"
        />
      )}

      <div>
        <h1 class="title my-2 text-4xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>

        <p class="text-sm text-gray-500 mb-2">Last updated: {displayDate}</p>

        {tools && Array.isArray(tools) && tools.length > 0 && (
          <p class="text-sm text-gray-500 mb-3">
            Tools: {tools.join(" · ")}
          </p>
        )}

        {(repo || demo || relatedPostUrl) && (
          <div class="mb-2 flex flex-wrap gap-2 not-prose">
            {demo && (
              <a href={demo} target="_blank" rel="noopener" class="btn btn-sm btn-primary">
                Live demo
              </a>
            )}
            {repo && (
              <a href={repo} target="_blank" rel="noopener" class="btn btn-sm btn-outline">
                GitHub
              </a>
            )}
            {relatedPostUrl && (
              <a href={relatedPostUrl} class="btn btn-sm btn-outline">
                Read the story: {relatedPostTitle}
              </a>
            )}
          </div>
        )}
      </div>

      <div class="divider my-2"></div>
      <slot />
    </article>
  </main>
</BaseLayout>
