---
const {
  title,
  subtitle,
  isLast = false,
  logo,
  logoClass = "h-8 w-8",
  delay = 0,
} = Astro.props;
---

<div
  class="timeline-entry relative flex gap-4"
  style={`--entry-delay: ${delay}ms`}
>
  <div class="flex flex-col items-center" aria-hidden="true">
    <span class="mt-2 h-3 w-3 shrink-0 rounded-full bg-primary"></span>
    {!isLast && <span class="mt-2 w-[2px] grow bg-primary/30"></span>}
  </div>

  <article class="min-w-0 flex-1 pb-8">
    <header class="flex items-start gap-3 sm:gap-4">
      {logo && (
        <span class="flex h-10 min-w-12 shrink-0 items-center justify-center bg-white px-1">
          <img src={logo} alt="" class:list={[logoClass, "object-contain"]} loading="lazy" />
        </span>
      )}
      <div class="min-w-0">
        <h3 class="text-lg font-semibold leading-snug text-base-content">{title}</h3>
        <p class="mt-1 text-sm leading-5 text-base-content/60">{subtitle}</p>
      </div>
    </header>

    <div class="timeline-copy mt-3 space-y-3 text-left text-sm leading-7 text-base-content/80">
      <slot />
    </div>
  </article>
</div>

<style>
  .timeline-entry {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--entry-delay);
  }

  .timeline-entry.is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-entry {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
