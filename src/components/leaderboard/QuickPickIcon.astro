---
interface Props {
  name: "speed" | "open" | "value" | "image" | "voice" | "video";
}

const { name } = Astro.props;
---

<span class:list={["fx-pick-icon", `is-${name}`]} aria-hidden="true">
  {
    name === "speed" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="m13.5 2.8-7 10h5l-1 8.4 7-10h-5l1-8.4Z" />
      </svg>
    )
  }
  {
    name === "open" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="10" width="14" height="10" rx="2" />
        <path d="M9 10V7a4 4 0 0 1 7.4-2" />
      </svg>
    )
  }
  {
    name === "value" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="8.5" />
        <path d="M14.8 8.5c-.7-.7-1.6-1-2.7-1-1.5 0-2.6.8-2.6 2s1 1.7 2.7 2.1c1.7.4 2.7 1 2.7 2.3 0 1.4-1.2 2.4-2.9 2.4-1.2 0-2.3-.4-3.1-1.2M12 5.8v12.4" />
      </svg>
    )
  }
  {
    name === "image" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="5" width="16" height="14" rx="2" />
        <circle cx="9" cy="10" r="1.4" />
        <path d="m6.5 17 4.2-4 2.6 2.3 2-1.8 2.5 3.5" />
      </svg>
    )
  }
  {
    name === "voice" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 10v4M8.5 7v10M12 4v16M15.5 7v10M19 10v4" />
      </svg>
    )
  }
  {
    name === "video" && (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3.5" y="6" width="12.5" height="12" rx="2" />
        <path d="m16 10 4.5-2.5v9L16 14" />
      </svg>
    )
  }
</span>
