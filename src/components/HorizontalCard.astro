---
const { title, img, desc, url, badge, target = "_self", date } = Astro.props;
import { Image } from "astro:assets";
import dayjs from "dayjs";
import localizedFormat from "dayjs/plugin/localizedFormat";
dayjs.extend(localizedFormat);
const displayDate = date ? dayjs(date).format("ll") : null;
---

<div
  class="rounded-lg bg-base-100 hover:shadow-xl transition ease-in-out hover:scale-[102%]"
>
  <a href={url} target={target}>
    <div class="hero-content flex-col md:flex-row">
      {
        img && (
          <Image
            src={img}
            width={750}
            height={422}
            format="webp"
            alt={title}
            class="max-w-full md:max-w-[13rem] rounded-lg"
          />
        )
      }
      <div class="grow w-full">
        <h1 class="text-xl font-bold">
          {title}
          {badge && <div class="badge badge-secondary mx-2">{badge}</div>}
        </h1>
        {displayDate && (
          <p class="text-xs text-base-content/60 mt-1">{displayDate}</p>
        )}
        <p class="py-1 text-1xl" set:html={desc}></p>
      </div>
    </div>
  </a>
</div>
